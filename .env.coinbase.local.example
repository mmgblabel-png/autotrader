# Copy this file to .env.coinbase.local and fill the values locally.
# NEVER commit the real .env.coinbase.local file.
#
# Use a dedicated Coinbase CDP API key created specifically for the
# AutoTrader Agent portfolio. Grant View + Trade only; keep Transfer disabled.
# COINBASE_API_SECRET may contain literal \\n sequences for PEM newlines.

COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_AGENT_PORTFOLIO_ID=

# Local dashboard/control secrets. setup-coinbase-local-windows.ps1 generates these.
PUBLIC_API_KEY=
AUTOTRADER_CONTROL_TOKEN=

# Optional username/password login. API-key login is enough if you prefer.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
PUBLIC_JWT_SECRET=
