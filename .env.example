# Application
APP_NAME="Amazon Associate Campaign Automaton"
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
DATABASE_PATH=./data/campaign_automaton.db
CAMPAIGN_CONFIG_PATH=./config/campaign.yaml
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

# Affiliate provider
AFFILIATE_PROVIDER=amazon
# Canonical product page used only as factual reference for draft generation. Do not add a tag here.
AMAZON_PRODUCT_URL=https://www.amazon.com/dp/B0BZYCJK89
# REQUIRED before approving a product CTA: paste the exact unmodified URL from
# Amazon Associates SiteStripe or Associates Central. This may be a tagged amazon.com URL
# or an amzn.to link. Never add UTM parameters, wrap it, cloak it, or use /r redirects.
AMAZON_ASSOCIATE_URL=
# The disclosure must remain in the same medium and adjacent to every affiliate CTA.
AFFILIATE_DISCLOSURE="Disclosure: As an Amazon Associate I earn from qualifying purchases. (paid link)"

# Legacy PayPro values are ignored while AFFILIATE_PROVIDER=amazon.
PAYPRO_PRODUCT_URL=https://www.paypro.nl/producten/WegMetDieKilos_Bronze_Plan/114766/183297
PAYPRO_AFFILIATE_ID=
PAYPRO_AFFILIATE_URL_TEMPLATE={product_url}
PAYPRO_WEBHOOK_SECRET=

# Security: generate each value with `openssl rand -hex 32`
CONTROL_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
WEBHOOK_TOKEN=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET

# LLM: omit OPENAI_API_KEY or use deterministic mode for no-cost validation
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-5-mini
LLM_FALLBACK_MODEL=gpt-5-nano
LLM_MAX_OUTPUT_TOKENS=3500
LLM_TIMEOUT_SECONDS=90
LLM_MAX_REQUESTS_PER_RUN=6
LLM_MAX_REQUESTS_PER_HOUR=30
LLM_MAX_REQUESTS_PER_DAY=150
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint:
OPENAI_BASE_URL=

# Scheduler and publishing guardrails
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=30
AUTO_RUN_DUE_CAMPAIGNS=false
# Cron expressions are interpreted in this IANA timezone.
SCHEDULE_TIMEZONE=Europe/Amsterdam
# Draft-only prevents all outbound publication. Keep true until each artifact is reviewed.
DRAFT_ONLY=true
# The public site remains private until the owner explicitly sets this to true.
WEBSITE_ENABLED=false
