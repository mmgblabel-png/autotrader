# Application
APP_NAME="WegMetDieKilos Campaign Automaton"
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
DATABASE_PATH=./data/campaign_automaton.db
CAMPAIGN_CONFIG_PATH=./config/campaign.yaml
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

# PayPro
PAYPRO_PRODUCT_URL=https://www.paypro.nl/producten/WegMetDieKilos_Bronze_Plan/114766/183297
PAYPRO_AFFILIATE_ID=VUL_HIER_JOUW_EIGEN_ID_IN
# Paste the exact URL format shown in your PayPro account. Examples only:
# PAYPRO_AFFILIATE_URL_TEMPLATE={product_url}
# PAYPRO_AFFILIATE_URL_TEMPLATE=https://example.invalid/ref/{affiliate_id}
PAYPRO_AFFILIATE_URL_TEMPLATE={product_url}
AFFILIATE_DISCLOSURE="Affiliate disclosure: als je via deze link bestelt, kan ik een commissie ontvangen. Jij betaalt hiervoor niet extra."

# Security: generate each value with `openssl rand -hex 32`
CONTROL_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
WEBHOOK_TOKEN=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET

# LLM: omit OPENAI_API_KEY or set LLM_PROVIDER=deterministic for no-cost fallback
LLM_PROVIDER=auto
LLM_MODEL=gpt-5-mini
LLM_FALLBACK_MODEL=gpt-5-nano
LLM_MAX_OUTPUT_TOKENS=3500
LLM_TIMEOUT_SECONDS=90
LLM_MAX_REQUESTS_PER_RUN=6
LLM_MAX_REQUESTS_PER_HOUR=30
LLM_MAX_REQUESTS_PER_DAY=150
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint:
OPENAI_BASE_URL=

# Scheduler and publishing guardrails
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=30
AUTO_RUN_DUE_CAMPAIGNS=false
DRAFT_ONLY=true
