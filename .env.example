# Safe defaults
EXECUTION_MODE=paper
EMERGENCY_STOP=true
BITVAVO_LIVE_TRADING=false
BITVAVO_DRY_RUN=true
LIVE_EXECUTION_APPROVED=false
LIVE_EXECUTION_ADAPTER_INSTALLED=false
LIVE_TRADING_CONFIRMATION=
MAX_TRADE_EUR=10
MAX_DAILY_EXPOSURE_EUR=50
MAX_DAILY_LOSS_EUR=25
MAX_SLIPPAGE_BPS=50
AUTOTRADER_TICK_INTERVAL=2

# Bitvavo secrets: set only in Railway Variables, never commit them.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
BITVAVO_ACCESS_WINDOW=10000
BITVAVO_OPERATOR_ID=1
# Retry transient SSL/network/5xx failures on idempotent public market-data reads.
BITVAVO_PUBLIC_READ_ATTEMPTS=3
# Retry transient SSL/network/5xx failures on idempotent public market-data reads.
BITVAVO_PUBLIC_READ_ATTEMPTS=3

# Dashboard/auth
AUTOTRADER_CONTROL_TOKEN=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
PUBLIC_JWT_SECRET=
CORS_ORIGINS=

# Cache private Bitvavo security probes to avoid API rate-limit churn.
BITVAVO_SECURITY_CACHE_SECONDS=60

# Cache read-only live market/open-order preflight checks.
LIVE_PREFLIGHT_CACHE_SECONDS=60

# Reconcile durable live order state even when strategies are stopped.
AUTOTRADER_JOURNAL_RECONCILE_SECONDS=60
